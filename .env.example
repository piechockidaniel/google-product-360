# ---------------------------------------------------------------- server
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Public https URL of this app (behind your reverse proxy). Needed for Google push notifications.
PUBLIC_URL=https://gmc.example.com
# ---------------------------------------------------------------- storage & auth
DATABASE_PATH=./data/gmc-manager.sqlite
# Long random string, e.g. `openssl rand -hex 32`. Also used to encrypt the stored service-account key –
# changing it later means re-entering the key in the wizard.
SESSION_SECRET=change-me-change-me-change-me
SESSION_TTL_HOURS=168
# Optional: first admin user, created on first start when no users exist.
# If left empty, the setup wizard asks for it in the browser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Google OAuth web client for operator sign-in. Configure the exact callback URI
# in Google Cloud, for example https://gmc.example.com/api/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://gmc.example.com/api/auth/google/callback
# Keep false in production; DEMO_MODE enables local login automatically.
LOCAL_LOGIN_ENABLED=false

# ---------------------------------------------------------------- Google Merchant Center
# Everything below this line can also be entered in the setup wizard (Settings -> Change configuration).
# Values stored through the wizard live in the database and take precedence over these defaults.
# Merchant Center account id (the number shown in the top-right corner of Merchant Center)
MERCHANT_ACCOUNT_ID=
# Service account key (JSON) – the service-account e-mail must be added as a user in Merchant Center.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
# ...or pass the JSON content directly (handy for container secrets):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
MERCHANT_API_BASE_URL=https://merchantapi.googleapis.com
MERCHANT_API_VERSION=v1
MERCHANT_LANGUAGE_CODE=pl-PL
MERCHANT_TIME_ZONE=Europe/Warsaw
# Use the built-in fake Merchant API (no Google credentials needed) – for development / demos.
MERCHANT_MOCK=false
# Self-contained demo on synthetic data (forces MERCHANT_MOCK, own database ./data/demo.sqlite, login demo/demo1234,
# Search Console connector + sample workflows pre-installed). Prefer `npm run demo`.
DEMO_MODE=false

# ---------------------------------------------------------------- behaviour
# Display name of the supplemental data source used to push enrichment attributes.
ENRICHMENT_DATA_SOURCE_NAME=GMC Manager enrichment
# Background product/issue sync interval in minutes (0 = disabled; you can still sync manually).
SYNC_INTERVAL_MINUTES=30
SYNC_ON_STARTUP=true
# Random secret that becomes part of the notification webhook URL: /api/webhooks/merchant/<secret>
WEBHOOK_SECRET=change-me-webhook-secret

# ---------------------------------------------------------------- Product360 (metrics & signals)
# Nightly pull of Merchant Center performance / Market Insights reports (5-field cron, account time zone)
METRICS_SYNC_CRON=0 4 * * *
# Days of history loaded on the first run (7-730)
METRICS_BACKFILL_DAYS=90
# Google Search Console property to pull organic search data for (optional; can also be chosen in Settings -> Product360).
# The service-account e-mail must be added as a user of the property in Search Console.
# SEARCH_CONSOLE_SITE_URL=sc-domain:example.com
