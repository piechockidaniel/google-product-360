{
  "name": "gmc-manager",
  "version": "1.0.0",
  "description": "Google Merchant Center manager: feeds, product status, issue tracking, workflows and product enrichment (Merchant API v1)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/index.ts",
    "dev:mock": "MERCHANT_MOCK=true tsx watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "npm --prefix client run build",
    "prestart": "npm run build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && npm --prefix client run typecheck && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "user:add": "tsx --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/cli/add-user.ts",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "demo:reset": "node --disable-warning=ExperimentalWarning scripts/demo.mjs --reset",
    "deploy": "bash deploy/deploy.sh",
    "postinstall": "node -e \"if(process.env.SKIP_CLIENT_INSTALL!=='1')require('child_process').execSync('npm --prefix client install',{stdio:'inherit'})\"",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "check": "npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.3.0",
    "croner": "^9.1.0",
    "fastify": "^5.12.5",
    "google-auth-library": "^9.15.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
